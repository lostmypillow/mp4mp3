{
    "name": "mp4mp3",
    "version": "2.1.0-SNAPSHOT",
    "description": "Full stack application for converting MP4 files to MP3 for my dad.",
    "license": "GNU AGPLv3",
    "author": "lostmypillow",
    "homepage": "https://github.com/lostmypillow/mp4mp3#readme",
    "bugs": {
        "url": "https://github.com/lostmypillow/mp4mp3/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lostmypillow/mp4mp3.git"
    },
    "type": "module",
    "main": "index.js",
    "scripts": {
        "ci": "npm run lint && npm run test",
        "lint": "node ./node_modules/ts7/bin/tsc -b && eslint . --ignore-pattern 'coverage/**'",
        "test": "vitest run --coverage",
        "e2e": "docker compose up -d --build && npm run deploy --workspace=frontend && playwright install && playwright test; docker compose down"
    },
    "workspaces": [
        "frontend",
        "backend"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.50.0",
        "@types/aws-lambda": "^8.10.162",
        "@types/debug": "^4.1.13",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.0.4",
        "aws-cdk": "2.1134.0",
        "aws-sdk-client-mock": "^4.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.8.0",
        "prettier": "^3.9.6",
        "ts7": "npm:typescript@^7.0.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.0",
        "vitest": "^4.1.11"
    }
}
