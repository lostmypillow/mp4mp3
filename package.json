{
    "name": "mp4mp3",
    "version": "2.0.0-SNAPSHOT",
    "description": "Full stack application for converting MP4 files to MP3 for my dad.",
    "license": "MIT",
    "author": "lostmypillow",
    "homepage": "https://github.com/lostmypillow/mp4mp3#readme",
    "bugs": {
        "url": "https://github.com/lostmypillow/mp4mp3/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lostmypillow/mp4mp3.git"
    },
    "license": "ISC",
    "author": "",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "ci": "npm run typecheck && npm run lint && npm run test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:aws": "vitest run --dir aws",
        "test:backend": "vitest run --dir backend",
        "test:e2e": "docker compose up -d --build && playwright test; docker compose down",
        "prod:up": "docker compose -f compose.prod.yaml up -d --build",
        "prod:down": "docker compose -f compose.prod.yaml down",
        "staging:up": "docker compose -f compose.dev.yaml up -d --build",
        "staging:down": "docker compose -f compose.dev.yaml down"
    },
    "workspaces": [
        "frontend",
        "aws",
        "backend"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.50.0",
        "@types/aws-lambda": "^8.10.162",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "aws-cdk": "2.1134.0",
        "aws-sdk-client-mock": "^4.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.8.0",
        "tsx": "^4.23.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.0",
        "vitest": "^4.1.11",
        "zod": "^4.4.3"
    }
}
