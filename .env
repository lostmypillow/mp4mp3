MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_API_CORS_ALLOW_ORIGIN=*
MINIO_NOTIFY_WEBHOOK_ENABLE_mp4mp3=on
MINIO_NOTIFY_WEBHOOK_ENDPOINT_mp4mp3=http://mp4mp3:3000/convert/events
MINIO_SERVER_URL=http://localhost:9000
PUBLIC_S3_ENDPOINT=http://localhost:9000
INTERNAL_S3_ENDPOINT=http://minio:9000
# Internal endpoint is the name of the Docker container for inter container networking
# In cases where MinIO is hosted on a non Docker network, this should be the same as the MINIO_SERVER_URL and PUBLIC_S3_ENDPOINT
UPLOAD_BUCKET_NAME=mp4mp3-upload
VITE_BUCKET_NAME=mp4mp3-frontend
VITE_API_URL=http://localhost:3000
VITE_APP_VERSION=2.1.0-SNAPSHOT
VITE_IS_AWS=false
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_EC2_METADATA_DISABLED=true
