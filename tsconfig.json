{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [
            "node"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "eslint.config.ts",
        "prettier.config.mjs",
        "aws/**/*",
        "backend/**/*"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/cdk.out"
    ]
}