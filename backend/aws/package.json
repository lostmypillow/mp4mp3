{
  "name": "mp4mp3-cdk",
  "version": "2.0.0-SNAPSHOT",
  "description": "AWS CDK definition for Lambdas that converts MP4 to MP3",
  "license": "MIT",
  "author": "lostmypillow",
  "type": "module",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "ci": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cdk": "cdk",
    "synth:layer": "npx cdk synth Mp4mp3LayerStack",
    "diff:layer": "npx cdk diff Mp4mp3LayerStack",
    "deploy:layer": "npx cdk deploy Mp4mp3LayerStack",
    "synth:lambda": "npx cdk synth Mp4mp3Stack",
    "diff:lambda": "npx cdk diff Mp4mp3Stack",
    "deploy:lambda": "npx cdk diff Mp4mp3Stack",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.1101.0",
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.5.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
