# Self-Hosted Staging MinIO & Backend Environment Configuration

SELF_HOSTED_S3_ENDPOINT=http://minio-server-staging:9000

# Public S3 endpoint for Staging (Change to your Staging S3 URL / IP if using reverse proxy)
# e.g., http://192.168.x.x:9002 or https://s3-staging.yourdomain.com
SELF_HOSTED_S3_PUBLIC_ENDPOINT=http://localhost:9002

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_REGION=us-east-1
BUCKET_NAME=my-bucket
NODE_ENV=staging
MAX_FILE_SIZE=10240
