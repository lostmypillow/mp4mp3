# For on-device development use
# Internal container-to-container S3 endpoint (Docker network hostname)
SELF_HOSTED_S3_ENDPOINT=http://minio-server:9000

# Public S3 endpoint for presigned URLs sent to client browsers
SELF_HOSTED_S3_PUBLIC_ENDPOINT=http://localhost:9000

# MinIO / S3 Storage Credentials
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_REGION=us-east-1
BUCKET_NAME=my-bucket

# Maximum allowed MP4 file size for conversion (in MB). 10240 = 10 GB
MAX_FILE_SIZE=10240

NODE_ENV=development
