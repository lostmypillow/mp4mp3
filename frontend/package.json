{
    "name": "frontend",
    "version": "2.1.0-SNAPSHOT",
    "private": "true",
    "description": "Express backend for converting MP4 to MP3",
    "license": "MIT",
    "author": "lostmypillow",
    "type": "module",
    "main": "eslint.config.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:dev": "vite build --mode dev",
        "build:prod": "vite build --mode prod",
        "preview": "vite preview",
        "deploy": "vite build && node --env-file=../.env deploy.ts",
        "deploy:dev": "vite build --mode dev && node --env-file=../.env.dev deploy.ts",
        "deploy:prod": "vite build --mode prod && node --env-file=../.env.prod deploy.ts"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.3.0",
        "@mui/icons-material": "^9.3.1",
        "@mui/material": "^9.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1100.0",
        "@types/mime-types": "^3.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "@vitest/coverage-v8": "^4.1.11",
        "globals": "^17.7.0",
        "mime-types": "^3.0.2",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0"
    }
}
